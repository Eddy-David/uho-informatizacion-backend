# =====================================================================
# SIGACU / UHO — Plantilla de variables de entorno del BACKEND
# ---------------------------------------------------------------------
# Ejecución aislada del backend, sin Docker.
# Normalmente basta con el .env de la raíz del monorepo; este archivo
# solo es necesario si ejecuta el backend por separado.
#
# Copie este archivo como "backend/.env" y ajuste los valores:
#   Linux / macOS :  cp .env.example .env
#
# NUNCA suba el archivo ".env" real al repositorio de Git.
# =====================================================================

DJANGO_ENV=development

# Clave secreta de Django. GENERE UNA NUEVA:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiame-por-una-clave-segura-y-unica-de-al-menos-50-caracteres
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_DB=uho_sigacu
POSTGRES_USER=uho_sigacu
POSTGRES_PASSWORD=cambiame_password_seguro
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------
# CORS / CSRF
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# Almacenamiento de archivos MinIO (S3 compatible)
# ---------------------------------------------------------------------
USE_MINIO=False
MINIO_ENDPOINT=http://localhost:9000
# Credenciales por defecto del contenedor de desarrollo de MinIO.
# CÁMBIELAS en cualquier entorno real.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=uho-sigacu-media

# ---------------------------------------------------------------------
# Redis / WebSockets
# ---------------------------------------------------------------------
USE_IN_MEMORY_CHANNEL_LAYER=True
REDIS_URL=redis://localhost:6379/1
