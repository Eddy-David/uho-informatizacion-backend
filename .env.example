# =====================================================================
# SIGACU / UHO — Plantilla de variables de entorno del BACKEND
# ---------------------------------------------------------------------
# Ejecución aislada del backend, sin Docker.
# Normalmente basta con el .env de la raíz del monorepo; este archivo
# solo es necesario si ejecuta el backend por separado.
#
# Copie este archivo como "backend/.env" y ajuste los valores:
#   Linux / macOS :  cp .env.example .env
#
# NUNCA suba el archivo ".env" real al repositorio de Git.
# =====================================================================

DJANGO_ENV=development

# Clave secreta de Django. GENERE UNA NUEVA:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiame-por-una-clave-segura-y-unica-de-al-menos-50-caracteres
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Zona horaria e idioma (Cuba)
LANGUAGE_CODE=es
TIME_ZONE=America/Havana

# Nivel de logs: DEBUG | INFO | WARNING | ERROR
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Autenticación JWT (Simple JWT)
# ---------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True

# Límite de intentos (django-rest-framework throttling)
THROTTLE_LOGIN=10/minute
THROTTLE_ANON=60/hour
THROTTLE_USER=2000/hour

# ---------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_DB=uho_sigacu
POSTGRES_USER=uho_sigacu
POSTGRES_PASSWORD=cambiame_password_seguro
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------
# CORS / CSRF
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# Almacenamiento de archivos MinIO (S3 compatible)
# ---------------------------------------------------------------------
USE_MINIO=False
MINIO_ENDPOINT=http://localhost:9000
# Credenciales por defecto del contenedor de desarrollo de MinIO.
# CÁMBIELAS en cualquier entorno real.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=uho-sigacu-media

# ---------------------------------------------------------------------
# Redis / WebSockets
# ---------------------------------------------------------------------
USE_IN_MEMORY_CHANNEL_LAYER=True
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ---------------------------------------------------------------------
# Integraciones institucionales (UHO)
# ---------------------------------------------------------------------
# Guía completa: docs/INTEGRACION_UHO.md (RNF-11: solo se cambia el .env).
# AGA_AUTH_MODE: mock (desarrollo) | real (valida contra auth.uho.edu.cu)
AGA_AUTH_ENABLED=False
AGA_AUTH_MODE=mock
AGA_AUTH_BASE_URL=
# Token de aplicación (Authorization: AGA <token>). NO versionar el valor real.
AGA_AUTH_TOKEN=
AGA_AUTH_ORIGIN=
AGA_AUTH_TIMEOUT=5

SIGENU_ENABLED=False
SIGENU_BASE_URL=
SIGENU_TOKEN=
SIGENU_TIMEOUT=5

ASSET_ENABLED=False
ASSET_BASE_URL=
ASSET_TOKEN=
ASSET_TIMEOUT=5

# Rutas de referencia del uho-auth-kit (Token DRF). El SIGACU usa JWT.
UHO_KIT_ENABLED=False

# ---------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=sigacu@uho.edu.cu
